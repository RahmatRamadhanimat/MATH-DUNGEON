# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (must be 3000 in AI Studio)
PORT=3000

# DATABASE_URL: Optional PostgreSQL connection string for external deployment.
# When not provided, the server uses its built-in persistent JSON/SQLite-compatible file store in ./data/math_maze_db.json
DATABASE_URL="postgresql://user:password@localhost:5432/math_maze"

# MAX_PLAYERS_PER_ROOM: Maximum classroom capacity per room
MAX_PLAYERS_PER_ROOM=45
